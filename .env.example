APP_NAME="CP Hub Backend"
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cp_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cp_hub
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AUTH_REFRESH_COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:5173
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_HUB_BASE_URL=
NOTIFY_HUB_API_KEY=
NOTIFY_HUB_WEBHOOK_SECRET=
